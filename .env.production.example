# Template for the server's .env. Copy to .env on the server and fill in real
# values. Never commit the filled-in file.
#
# Start the stack with:
#   docker compose --env-file .env -f infra/compose/compose.yml -f infra/compose/compose.prod.yml up -d --build

# --- Public address -------------------------------------------------------
# A domain whose DNS A record points at this server. Caddy gets a certificate for it.
SITE_DOMAIN=facilities.example.com
# Leave unset in production (80/443). Override only for a local dry run.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# --- Secrets (generate each one: openssl rand -hex 32) ---------------------
POSTGRES_PASSWORD=
JWT_SECRET=
LLM_API_KEY=
# Only needed with --profile observability. Set it before enabling Grafana.
GRAFANA_ADMIN_PASSWORD=

# --- Application ------------------------------------------------------------
APP_ENV=production
EVALUATION_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
CLASSIFIER_MODEL=gpt-5-nano
GENERATOR_MODEL=gpt-5-nano
LLM_REASONING_EFFORT=minimal
LLM_MAX_OUTPUT_TOKENS=1024
EMBEDDING_MODEL=text-embedding-3-small
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://facilities.example.com
