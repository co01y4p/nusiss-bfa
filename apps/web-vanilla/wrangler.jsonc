{
  // Vanilla demo deployment of the Facilities AI Assistant harness (M1 slice).
  // Deployed to the co01y4p Cloudflare account.
  "name": "nusiss-bfa",
  "account_id": "2a0459c37d5dc00abfc891078ec70fc3",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Run the Worker for every request (not just /api/*) so it can enforce the
    // site-wide Google sign-in gate before any static page/asset is served.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nusiss-bfa-db",
      "database_id": "e659a547-a91c-4645-b9a0-32d8b041fdc9"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "799575551375-bp2u6p7dinn385pr0l9jnr8br8k66l85.apps.googleusercontent.com"
  }
  // SESSION_SECRET and MANAGER_EMAILS are set via `wrangler secret put <NAME>`
  // (production) and apps/web-vanilla/.dev.vars (local) — never committed here.
}
