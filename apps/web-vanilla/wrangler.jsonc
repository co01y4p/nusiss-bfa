{
  // Vanilla demo deployment of the Facilities AI Assistant harness (M1 slice).
  // Deployed to the co01y4p Cloudflare account.
  "name": "nusiss-bfa",
  "account_id": "2a0459c37d5dc00abfc891078ec70fc3",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nusiss-bfa-db",
      "database_id": "e659a547-a91c-4645-b9a0-32d8b041fdc9"
    }
  ],
  "vars": {
    // Demo-only manager passcode (the real project uses JWT + Argon2id per M1).
    "MANAGER_PASSCODE": "bfa-manager-2026"
  }
}
